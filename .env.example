# Local Supabase connection values from `npm run db:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Exact Google account permitted to administer the CMS.
ADMIN_EMAIL=your-admin@gmail.com
APP_ORIGIN=http://localhost:3000

# Non-secret application defaults.
LOG_LEVEL=info
